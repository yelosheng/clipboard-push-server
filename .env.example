# Flask Configuration
# REQUIRED. The server refuses to start while this is empty.
# Generate one with:  openssl rand -hex 32
FLASK_SECRET_KEY=
FLASK_DEBUG=0

# Admin Dashboard
ADMIN_PASSWORD=change_me_before_deploying

# File Storage Backend
# Set to 'local' to store files on the server instead of Cloudflare R2.
# When using 'local', set LOCAL_STORAGE_BASE_URL to the server's public URL
# so clients can reach the upload/download endpoints.
# STORAGE_BACKEND=r2
# LOCAL_STORAGE_BASE_URL=https://your.domain.com
# LOCAL_STORAGE_PATH=./data/uploads

# Cloudflare R2 Configuration
# You can find these in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=clipboard-push-relay
DASHBOARD_R2_BUCKET=your-r2-bucket-name

# Firebase Cloud Messaging (optional — leave empty/unset to disable FCM).
# When unset (or firebase-admin not installed), all FCM calls are silent
# no-ops and Socket.IO stays the only delivery channel (no background wake).
# Download service account JSON from Firebase Console → Project Settings → Service Accounts.
# Under Docker: put the JSON in ./data (the only mounted directory) and use
# the in-container path, e.g. /app/data/firebase-service-account.json
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
